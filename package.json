{
  "name": "chud-finder",
  "version": "3.3.0",
  "private": true,
  "license": "MIT",
  "description": "Chud Finder: browser-native provenance layer for X (MV3 extension, Chrome + Brave).",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.ts && node test/legacy/settings.test.cjs && node test/legacy/test.cjs && python bot/test_lookup.py",
    "gen:tz": "python3 tools/gen-tz.py",
    "adapter": "node server/adapter.ts",
    "test:browser": "node tools/live-investigation.mjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "0.9.11",
    "exifr": "7.1.3",
    "zod": "^4.6.7"
  }
}
